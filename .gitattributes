# Always check out scripts, config and systemd units with LF line endings.
# CRLF breaks bash (`$'\r': command not found`, values ending in "\r") and
# systemd unit parsing when files are copied from a Windows checkout.
* text=auto eol=lf
*.sh       text eol=lf
*.conf     text eol=lf
*.service  text eol=lf
*.timer    text eol=lf
*.md       text eol=lf
LICENSE    text eol=lf
