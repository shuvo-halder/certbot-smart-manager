[Unit]
Description=Certbot Smart Manager - SSL Certificate Renewal Service
Documentation=https://github.com/shuvo-halder/certbot-smart-manager
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/ssl-manager --auto
User=root
Group=root
UMask=027
# The script writes its own log file (/var/log/certbot-smart-manager.log).
# stdout/stderr go to the journal: `journalctl -u certbot-smart.service`.
# (Appending them to the log file as well would duplicate every line.)
StandardOutput=journal
StandardError=journal
Environment=HOME=/root
Environment=CONFIG_FILE=/etc/certbot-smart-manager/certbot-smart.conf

# Security hardening — deliberately moderate.
#
# The job of this unit is to renew certificates unattended; a sandbox that
# makes renewal fail defeats the purpose. Options that are intentionally
# NOT used, and why:
#   ProtectSystem=full/strict  certbot's nginx/apache plugins edit /etc/nginx,
#                              /etc/apache2; ufw/firewalld write under /etc.
#   ProtectHome                webroot challenges often live under /home/*/.
#   NoNewPrivileges,           snap-installed certbot (the method certbot's
#   RestrictNamespaces,        own docs recommend) runs through snap-confine,
#   CapabilityBoundingSet,     which needs setuid, mount namespaces,
#   ProtectControlGroups,      CAP_SYS_ADMIN and cgroup access — every one of
#   ProtectKernelTunables      these would make every snap renewal fail.
#   PrivateDevices             `wall` console notifications need the TTYs.
LockPersonality=yes
PrivateTmp=yes
ProtectSystem=true
ProtectKernelModules=yes
RestrictRealtime=yes

[Install]
WantedBy=multi-user.target
