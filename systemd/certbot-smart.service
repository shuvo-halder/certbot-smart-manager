[Unit]
Description=Certbot Smart Manager - SSL Certificate Renewal Service
Documentation=https://github.com/shuvo-halder/certbot-smart-manager
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/ssl-manager --auto
User=root
Group=root
UMask=027
# The script writes its own log file (/var/log/certbot-smart-manager.log).
# stdout/stderr go to the journal: `journalctl -u certbot-smart.service`.
# (Appending them to the log file as well would duplicate every line.)
StandardOutput=journal
StandardError=journal
Environment=HOME=/root
Environment=CONFIG_FILE=/etc/certbot-smart-manager/certbot-smart.conf

# Security hardening
#
# ProtectSystem=true (not "full"): /usr and /boot are read-only, but /etc
# stays writable. certbot's nginx/apache plugins edit /etc/nginx or
# /etc/apache2 during renewal, and ufw/firewalld write under /etc — with
# "full" those renewals and firewall changes would fail.
# PrivateDevices is not set so `wall` console notifications can reach TTYs.
LockPersonality=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_ADMIN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_CHOWN CAP_FOWNER CAP_SETUID CAP_SETGID CAP_KILL
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictNamespaces=yes

[Install]
WantedBy=multi-user.target
